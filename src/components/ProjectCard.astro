---
import ProjectCover from './ProjectCover.astro';
import { serviceBySlug } from '../data/services';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index?: number;
}
const { project, index } = Astro.props;
const tags = project.services.map((s) => serviceBySlug(s)?.name).filter(Boolean);
---

<article class="card reveal">
  <a href={`/proyectos/${project.slug}/`} class="card__link">
    <ProjectCover project={project} />
    <div class="card__meta">
      {typeof index === 'number' && <span class="card__n serif">{String(index + 1).padStart(2, '0')}</span>}
      <h3 class="card__title">{project.title}</h3>
    </div>
  </a>
  {tags.length > 0 && <p class="card__tags caps">{tags.join(' · ')}</p>}
</article>

<style>
  .card__link {
    display: block;
    text-decoration: none;
  }
  .card__meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .card__n {
    font-size: var(--fs-sm);
    opacity: 0.7;
  }
  .card__title {
    font-size: var(--fs-lg);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .card__link:hover .card__title {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }
  .card__tags {
    margin-top: 0.4rem;
    opacity: 0.75;
  }
</style>
