---
import Base from '../layouts/Base.astro';
import Brand from '../components/Brand.astro';
import Marquee from '../components/Marquee.astro';
import { SERVICES } from '../data/services';
import { PROJECTS } from '../data/projects';

const marks = ['icon-ola', 'icon-trazo', 'icon-asterisco', 'isotipo'];
const projectsFor = (slug: string) => PROJECTS.filter((p) => p.services.includes(slug));
---

<Base
  title="Servicios"
  description="Branding, manuales de marca, redes sociales, contenido, diseño gráfico, paid media, campañas y eventos."
  headerTone="fucsia"
>
  <section class="s-hero t-fucsia" aria-labelledby="title">
    <Brand name="swoosh-b" class="s-hero__swoosh" />
    <div class="wrap">
      <p class="label">Servicios</p>
      <h1 id="title" class="s-hero__title">
        Capacidad <br />para hacer
        <span class="s-hero__echo serif">
          <span>lo que quieras.</span>
          <span aria-hidden="true">lo que quieras.</span>
          <span aria-hidden="true">lo que quieras.</span>
          <span aria-hidden="true">lo que quieras.</span>
          <span aria-hidden="true">lo que quieras.</span>
        </span>
      </h1>
    </div>
  </section>

  <section class="t-rosa s-list" aria-label="Lista de servicios">
    <div class="wrap">
      <ol role="list">
        {
          SERVICES.map((s, i) => {
            const related = projectsFor(s.slug);
            return (
              <li class="s-item reveal" id={s.slug}>
                <span class="s-item__n serif">{String(i + 1).padStart(2, '0')}</span>
                <div class="s-item__body">
                  <h2 class="s-item__name">{s.name}</h2>
                  <p class="s-item__desc">{s.desc}</p>
                  {related.length > 0 && (
                    <p class="s-item__related caps">
                      Proyectos:{' '}
                      {related.map((p, j) => (
                        <>
                          {j > 0 && ' · '}
                          <a href={`/proyectos/${p.slug}/`}>{p.title}</a>
                        </>
                      ))}
                    </p>
                  )}
                </div>
                <Brand name={marks[i % marks.length]} class="s-item__mark" />
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <Marquee class="t-azul" items={['Crear o reventar.', 'Le damos fuerza a tu marca.']} reverse />
</Base>

<style>
  .s-hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(8rem, 18vh, 12rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
  }
  .s-hero :global(.s-hero__swoosh) {
    position: absolute;
    width: min(70rem, 140vw);
    right: -18%;
    bottom: -10%;
    color: var(--rosa);
    opacity: 0.7;
  }
  .s-hero .wrap {
    position: relative;
  }
  .s-hero__title {
    margin-top: 1.5rem;
    font-size: var(--fs-4xl);
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  .s-hero__echo {
    display: block;
    margin-top: 0.15em;
    font-size: 0.62em;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }
  .s-hero__echo span {
    display: block;
  }
  .s-hero__echo span:nth-child(2) { opacity: 0.7; }
  .s-hero__echo span:nth-child(3) { opacity: 0.5; }
  .s-hero__echo span:nth-child(4) { opacity: 0.32; }
  .s-hero__echo span:nth-child(5) { opacity: 0.18; }

  .s-list {
    padding-block: var(--section);
  }
  .s-list ol {
    border-top: 1px solid var(--linea);
  }
  .s-item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.5rem 1.25rem;
    padding-block: clamp(2rem, 4vw, 3.25rem);
    border-bottom: 1px solid var(--linea);
    scroll-margin-top: 2rem;
  }
  .s-item:target {
    background: linear-gradient(90deg, color-mix(in srgb, var(--fucsia) 35%, transparent), transparent 70%);
  }
  .s-item__n {
    font-size: var(--fs-sm);
    padding-top: 0.6em;
  }
  .s-item__name {
    font-size: var(--fs-2xl);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .s-item__desc {
    margin-top: 1rem;
    max-width: 36rem;
    font-family: var(--font-serif);
    font-weight: 300;
    font-variation-settings: 'SOFT' 100;
    font-size: var(--fs-lg);
    line-height: 1.4;
    color: var(--negro);
  }
  .s-item__related {
    margin-top: 1.25rem;
    color: var(--negro);
  }
  .s-item__related a {
    text-underline-offset: 0.2em;
  }
  .s-item :global(.s-item__mark) {
    display: none;
  }

  @media (min-width: 56rem) {
    .s-item {
      grid-template-columns: 5rem 1fr 7rem;
      align-items: start;
    }
    .s-item :global(.s-item__mark) {
      display: block;
      width: 100%;
      max-height: 5rem;
      color: var(--fucsia);
      opacity: 0.85;
      transition: transform 0.6s var(--ease-out);
    }
    .s-item:hover :global(.s-item__mark) {
      transform: rotate(-12deg) scale(1.08);
    }
    .s-item :global(.s-item__mark svg) {
      max-height: 5rem;
      width: auto;
      margin-left: auto;
    }
  }
</style>
